# Production must use the public HTTPS origin, without a trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback; prefer NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Configure Google OAuth in Supabase; do not put its client secret here.
TELEGRAM_BOT_TOKEN=
# High-entropy value sent as Telegram's secret_token; never use the bot token.
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=eblooddonataionbot
# Must be false in production.
MOCK_TELEGRAM=true
RAKTKOSH_ENDPOINT=https://eraktkosh.mohfw.gov.in/BLDAHIMS/bloodbank/nearbyBB.cnt
RAKTKOSH_STATE_CODE=
RAKTKOSH_DISTRICT_CODE=

# Telegram bot: @eblooddonataionbot
